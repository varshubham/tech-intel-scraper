# Copy to .env and adjust. Every value has a sensible default.

# ---------- crawling ----------
# seconds between requests to the same site
REQUEST_DELAY=3
REQUEST_TIMEOUT=30
RESPECT_ROBOTS=true
# re-use downloaded pages for this many hours
CACHE_TTL_HOURS=12
# event pages opened per source per crawl (to find brochures / missing fields)
MAX_DETAIL_PAGES=30
DOWNLOAD_BROCHURES=true
# Identify yourself honestly; put a contact URL or email you own
USER_AGENT=Mozilla/5.0 (compatible; TechEventsBot/1.0; +https://example.com/bot)

# ---------- scheduler (runs inside `serve`) ----------
# 0 = off (use when an external cron / platform scheduler runs `python cli.py crawl`)
CRAWL_INTERVAL_HOURS=24

# ---------- API ----------
# required for POST /api/crawl; leave empty to disable manual HTTP crawls
API_TOKEN=change-me
PORT=8000

# ---------- leads: businesses near a point (python cli.py leads) ----------
# centre of the search and how far around it to look
LEAD_LAT=
LEAD_LNG=
LEAD_RADIUS_KM=6
# comma-separated: hospital, clinic, doctor, dentist, pharmacy, laboratory, school, college,
# university, hotel, restaurant, bank, company, factory, or a raw OpenStreetMap tag like office=it
LEAD_TYPES=hospital,clinic
# only the nearest N businesses get their websites checked
LEAD_MAX_BUSINESSES=100
# pages read per website: home + contact/team/about pages
LEAD_MAX_PAGES=4
# re-read JavaScript-only websites through Jina Reader (r.jina.ai); key optional, raises rate limits
LEAD_JINA_FALLBACK=true
JINA_API_KEY=
# set to use Google Places instead of OpenStreetMap (better coverage, paid per request)
GOOGLE_PLACES_API_KEY=

# ---------- optional extras ----------
# needs the image built with INSTALL_PLAYWRIGHT=true
USE_PLAYWRIGHT=false
USE_LLM=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# where DB, brochures, exports and cache live (default ./data, /app/data in Docker)
# DATA_DIR=./data
